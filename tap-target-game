<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

<title>Zombie Rush 🧟</title>

<style>

* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
  user-select: none;
}

body {
  margin: 0;
  min-height: 100vh;
  overflow: hidden;

  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "SF Pro Display",
    Arial,
    sans-serif;

  color: white;

  background:
    radial-gradient(circle at 20% 20%, #7b2cff 0%, transparent 25%),
    radial-gradient(circle at 80% 30%, #00e5ff 0%, transparent 22%),
    radial-gradient(circle at 50% 100%, #ff007a 0%, transparent 30%),
    #090b18;
}


/* =========================
   HEADER
========================= */

.header {
  text-align: center;
  padding: 18px 10px 8px;
  position: relative;
  z-index: 5;
}

h1 {
  margin: 0;

  font-size: 34px;
  font-weight: 900;
  letter-spacing: -1px;

  text-shadow:
    0 0 8px #00eaff,
    0 0 20px #00eaff;
}

.subtitle {
  margin-top: 3px;
  color: #cbd0ff;
  font-size: 14px;
}


/* =========================
   STATS
========================= */

.stats {
  display: flex;
  justify-content: center;
  gap: 8px;
  padding: 7px;
  position: relative;
  z-index: 5;
}

.stat {
  min-width: 82px;

  padding: 8px 10px;

  border-radius: 15px;

  background:
    linear-gradient(
      135deg,
      #ffffff20,
      #ffffff08
    );

  border: 1px solid #ffffff25;

  backdrop-filter: blur(12px);

  text-align: center;

  box-shadow:
    0 5px 20px #00000040;
}

.stat-label {
  color: #b9c0e8;
  font-size: 10px;
  font-weight: 700;
}

.stat-value {
  font-size: 21px;
  font-weight: 900;
  margin-top: 2px;
}


/* =========================
   GAME
========================= */

#game {

  position: relative;

  height: calc(100vh - 145px);

  min-height: 420px;

  margin: 5px 10px 10px;

  overflow: hidden;

  border-radius: 28px;

  background:

    linear-gradient(
      180deg,
      #111536 0%,
      #171342 50%,
      #090c1d 100%
    );

  border: 2px solid #ffffff18;

  box-shadow:
    0 0 40px #00000070,
    inset 0 0 50px #00000080;
}


/* CITY LIGHTS */

#game::before {

  content: "";

  position: absolute;

  inset: 0;

  opacity: .55;

  background:

    linear-gradient(
      90deg,
      transparent 0 8%,
      #00eaff 8% 9%,
      transparent 9% 18%,
      #ff3cac 18% 19%,
      transparent 19% 31%,
      #ffd000 31% 32%,
      transparent 32% 44%,
      #00ff95 44% 45%,
      transparent 45% 58%,
      #ff3cac 58% 59%,
      transparent 59% 73%,
      #00eaff 73% 74%,
      transparent 74% 88%,
      #ffd000 88% 89%,
      transparent 89%
    );

  transform: translateY(65%);

  filter: blur(2px);
}


/* GROUND */

#game::after {

  content: "";

  position: absolute;

  left: 0;
  right: 0;
  bottom: 0;

  height: 24%;

  background:
    repeating-linear-gradient(
      90deg,
      #171b35 0px,
      #171b35 50px,
      #202542 51px,
      #202542 53px
    );

  opacity: .8;

}


/* =========================
   ZOMBIE
========================= */

.zombie {

  position: absolute;

  width: 82px;
  height: 105px;

  cursor: pointer;

  z-index: 10;

  animation:
    zombieAppear .18s ease-out,
    zombieFloat 1.1s infinite ease-in-out;

  filter:
    drop-shadow(0 8px 12px #00000080);
}


@keyframes zombieAppear {

  from {
    transform: scale(.2) rotate(-15deg);
    opacity: 0;
  }

  to {
    transform: scale(1) rotate(0);
    opacity: 1;
  }

}


@keyframes zombieFloat {

  0%,100% {
    margin-top: 0;
  }

  50% {
    margin-top: -6px;
  }

}


/* HEAD */

.zombie-head {

  position: absolute;

  width: 58px;
  height: 58px;

  left: 12px;
  top: 3px;

  border-radius: 45% 48% 42% 45%;

  background:
    linear-gradient(
      135deg,
      #72ff70,
      #1bbd62
    );

  border: 3px solid #0a693c;

  box-shadow:
    inset -8px -8px 0 #15954f;

}


/* HAIR */

.zombie-hair {

  position: absolute;

  top: -7px;
  left: 9px;

  width: 55px;
  height: 18px;

  background: #242044;

  border-radius: 50% 50% 15% 15%;

}


/* EYES */

.eye {

  position: absolute;

  width: 14px;
  height: 14px;

  top: 20px;

  background: white;

  border-radius: 50%;

  box-shadow:
    0 0 8px #fff;
}

.eye.left {
  left: 13px;
}

.eye.right {
  right: 13px;
}

.eye::after {

  content: "";

  position: absolute;

  width: 6px;
  height: 6px;

  background: #ff236f;

  border-radius: 50%;

  top: 4px;
  left: 4px;

}


/* MOUTH */

.zombie-mouth {

  position: absolute;

  left: 17px;
  top: 39px;

  width: 27px;
  height: 11px;

  background: #3b0b28;

  border-radius: 4px 4px 10px 10px;

  border: 2px solid #82174e;

}


/* BODY */

.zombie-body {

  position: absolute;

  left: 15px;
  top: 57px;

  width: 52px;
  height: 43px;

  background:
    linear-gradient(
      135deg,
      #8b5cff,
      #4b27c9
    );

  border-radius: 13px 13px 8px 8px;

  border: 3px solid #24106d;

}


/* ARMS */

.arm {

  position: absolute;

  width: 43px;
  height: 12px;

  top: 66px;

  background: #50e86a;

  border: 3px solid #167d43;

  border-radius: 10px;

}

.arm.left {
  left: -18px;
  transform: rotate(-25deg);
}

.arm.right {
  right: -18px;
  transform: rotate(25deg);
}


/* =========================
   HIT EFFECT
========================= */

.hit {

  position: absolute;

  pointer-events: none;

  z-index: 30;

  font-size: 35px;

  font-weight: 900;

  animation:
    hitAnimation .5s ease-out forwards;

  text-shadow:
    0 0 10px #00ffff,
    0 0 20px #ff00aa;
}


@keyframes hitAnimation {

  0% {
    transform: scale(.5) translateY(0);
    opacity: 1;
  }

  100% {
    transform: scale(1.5) translateY(-70px);
    opacity: 0;
  }

}


/* =========================
   START / GAME OVER
========================= */

.overlay {

  position: absolute;

  inset: 0;

  display: flex;

  align-items: center;

  justify-content: center;

  background:
    radial-gradient(
      circle,
      #26135dcc,
      #050611ee
    );

  backdrop-filter: blur(7px);

  z-index: 50;

  text-align: center;

  padding: 25px;
}


.panel {

  width: 100%;
  max-width: 380px;

  padding: 28px;

  border-radius: 28px;

  background:
    linear-gradient(
      135deg,
      #ffffff18,
      #ffffff08
    );

  border: 1px solid #ffffff25;

  box-shadow:
    0 20px 60px #00000070;

}


.big-emoji {

  font-size: 75px;

  animation:
    floatEmoji 1.5s infinite ease-in-out;

}


@keyframes floatEmoji {

  50% {
    transform: translateY(-10px) rotate(4deg);
  }

}


.panel h2 {

  font-size: 31px;

  margin: 10px 0;

  text-shadow:
    0 0 15px #ff2cac;

}


.panel p {

  color: #c7c9e8;

  line-height: 1.5;

}


.start-button {

  width: 100%;

  margin-top: 12px;

  padding: 16px;

  border: 0;

  border-radius: 16px;

  color: white;

  font-size: 18px;

  font-weight: 800;

  background:
    linear-gradient(
      90deg,
      #7b2cff,
      #ff1493,
      #00d9ff
    );

  box-shadow:
    0 0 20px #a32cff70;

  transition: transform .15s;

}


.start-button:active {

  transform: scale(.95);

}


.hidden {
  display: none;
}


/* =========================
   COMBO
========================= */

.combo {

  position: absolute;

  top: 12px;
  left: 50%;

  transform: translateX(-50%);

  z-index: 40;

  font-size: 20px;

  font-weight: 900;

  color: #ffe600;

  text-shadow:
    0 0 10px #ff8a00,
    0 0 20px #ff0077;

  animation: comboPop .25s ease-out;

}


@keyframes comboPop {

  from {
    transform:
      translateX(-50%)
      scale(.5);
  }

  to {
    transform:
      translateX(-50%)
      scale(1);
  }

}


/* =========================
   RESPONSIVE
========================= */

@media (max-width: 500px) {

  h1 {
    font-size: 29px;
  }

  .stat {
    min-width: 75px;
  }

}

</style>
</head>


<body>


<div class="header">

  <h1>🧟 ZOMBIE RUSH</h1>

  <div class="subtitle">
    Survive the neon night.
  </div>

</div>


<div class="stats">

  <div class="stat">

    <div class="stat-label">
      TIME
    </div>

    <div class="stat-value" id="time">
      30
    </div>

  </div>


  <div class="stat">

    <div class="stat-label">
      SCORE
    </div>

    <div class="stat-value" id="score">
      0
    </div>

  </div>


  <div class="stat">

    <div class="stat-label">
      COMBO
    </div>

    <div class="stat-value" id="combo">
      0
    </div>

  </div>


  <div class="stat">

    <div class="stat-label">
      ❤️
    </div>

    <div class="stat-value" id="health">
      5
    </div>

  </div>

</div>


<div id="game">


  <!-- START SCREEN -->

  <div class="overlay" id="startScreen">

    <div class="panel">

      <div class="big-emoji">
        🧟
      </div>

      <h2>
        Zombie Rush
      </h2>

      <p>
        The city is overrun!<br>
        Tap the zombies before they disappear.
      </p>

      <p>
        ⚡ Build combos<br>
        💥 Get bonus points<br>
        ❤️ Don't let them escape
      </p>

      <button
        class="start-button"
        onclick="startGame()">

        🧟 START SURVIVAL

      </button>

    </div>

  </div>


  <!-- GAME OVER -->

  <div
    class="overlay hidden"
    id="gameOver">

    <div class="panel">

      <div class="big-emoji">
        🏆
      </div>

      <h2>
        NIGHT OVER
      </h2>

      <p>
        Final Score
      </p>

      <div
        id="finalScore"
        style="
          font-size:60px;
          font-weight:900;
          color:#00eaff;
          text-shadow:0 0 20px #00eaff;
        ">
        0
      </div>

      <div
        id="bestScore"
        style="
          color:#ffe600;
          font-size:18px;
          font-weight:800;
          margin:10px;
        ">
        🏆 Best: 0
      </div>

      <button
        class="start-button"
        onclick="startGame()">

        🔄 PLAY AGAIN

      </button>

    </div>

  </div>


</div>


<script>


/* =========================
   VARIABLES
========================= */

let score = 0;

let combo = 0;

let health = 5;

let time = 30;

let gameRunning = false;

let timer = null;

let zombieTimer = null;

let zombie = null;

let bestScore =
  Number(
    localStorage.getItem(
      "zombieRushBest"
    )
  ) || 0;


/* =========================
   START GAME
========================= */

function startGame() {

  score = 0;

  combo = 0;

  health = 5;

  time = 30;

  gameRunning = true;

  document
    .getElementById("startScreen")
    .classList.add("hidden");

  document
    .getElementById("gameOver")
    .classList.add("hidden");

  clearInterval(timer);

  clearInterval(zombieTimer);

  clearZombie();

  updateStats();

  spawnZombie();


  /* TIMER */

  timer = setInterval(() => {

    time--;

    updateStats();

    if (time <= 0) {

      endGame();

    }

  }, 1000);


  /* ZOMBIES */

  zombieTimer =
    setInterval(() => {

      if (gameRunning) {

        spawnZombie();

      }

    }, 1200);

}


/* =========================
   SPAWN ZOMBIE
========================= */

function spawnZombie() {

  if (!gameRunning) return;

  clearZombie();

  zombie =
    document.createElement("div");

  zombie.className =
    "zombie";


  zombie.innerHTML = `

    <div class="zombie-hair"></div>

    <div class="zombie-head">

      <div class="eye left"></div>

      <div class="eye right"></div>

      <div class="zombie-mouth"></div>

    </div>

    <div class="zombie-body"></div>

    <div class="arm left"></div>

    <div class="arm right"></div>

  `;


  let game =
    document.getElementById("game");

  let rect =
    game.getBoundingClientRect();


  let sizeX = 82;

  let sizeY = 105;


  let maxX =
    rect.width - sizeX;

  let maxY =
    rect.height - sizeY;


  let x =
    Math.random() * maxX;

  let y =
    40 +
    Math.random() *
    Math.max(50, maxY - 40);


  zombie.style.left =
    x + "px";

  zombie.style.top =
    y + "px";


  zombie.onclick =
    function(event) {

      event.stopPropagation();

      hitZombie();

    };


  game.appendChild(zombie);


  /* ZOMBIE DISAPPEARS */

  let speed =
    Math.max(
      450,
      1200 - score * 18
    );


  setTimeout(() => {

    if (
      zombie &&
      zombie.parentNode &&
      gameRunning
    ) {

      zombieEscaped();

    }

  }, speed);

}


/* =========================
   HIT ZOMBIE
========================= */

function hitZombie() {

  if (!gameRunning) return;


  combo++;


  let points = 10;


  /* COMBO BONUS */

  if (combo >= 5) {

    points += 10;

  }

  if (combo >= 10) {

    points += 20;

  }


  score += points;


  createHitEffect(
    zombie.offsetLeft,
    zombie.offsetTop,
    "+" + points
  );


  clearZombie();

  updateStats();


  /* IMMEDIATELY SPAWN */

  setTimeout(() => {

    if (gameRunning) {

      spawnZombie();

    }

  }, 120);

}


/* =========================
   ZOMBIE ESCAPES
========================= */

function zombieEscaped() {

  if (!gameRunning) return;


  health--;

  combo = 0;


  createHitEffect(
    zombie.offsetLeft,
    zombie.offsetTop,
    "💨"
  );


  clearZombie();

  updateStats();


  if (health <= 0) {

    endGame();

    return;

  }


  spawnZombie();

}


/* =========================
   HIT EFFECT
========================= */

function createHitEffect(
  x,
  y,
  text
) {

  let effect =
    document.createElement("div");

  effect.className =
    "hit";

  effect.innerText =
    text;

  effect.style.left =
    x + "px";

  effect.style.top =
    y + "px";


  document
    .getElementById("game")
    .appendChild(effect);


  setTimeout(() => {

    effect.remove();

  }, 500);

}


/* =========================
   COMBO TEXT
========================= */

function showCombo() {

  if (combo < 3) return;


  let text =
    document.createElement("div");

  text.className =
    "combo";

  text.innerText =
    "🔥 " + combo + " COMBO!";


  document
    .getElementById("game")
    .appendChild(text);


  setTimeout(() => {

    text.remove();

  }, 650);

}


/* =========================
   CLEAR ZOMBIE
========================= */

function clearZombie() {

  if (zombie) {

    zombie.remove();

    zombie = null;

  }

}


/* =========================
   UPDATE STATS
========================= */

function updateStats() {

  document
    .getElementById("score")
    .innerText =
      score;


  document
    .getElementById("combo")
    .innerText =
      combo;


  document
    .getElementById("health")
    .innerText =
      health;


  document
    .getElementById("time")
    .innerText =
      time;


  if (combo >= 3) {

    showCombo();

  }

}


/* =========================
   END GAME
========================= */

function endGame() {

  gameRunning = false;


  clearInterval(timer);

  clearInterval(zombieTimer);


  clearZombie();


  if (score > bestScore) {

    bestScore = score;

    localStorage.setItem(
      "zombieRushBest",
      bestScore
    );

  }


  document
    .getElementById("finalScore")
    .innerText =
      score;


  document
    .getElementById("bestScore")
    .innerText =
      "🏆 Best: " + bestScore;


  document
    .getElementById("gameOver")
    .classList.remove("hidden");

}


/* =========================
   RESIZE
========================= */

window.addEventListener(
  "resize",
  () => {

    if (gameRunning) {

      spawnZombie();

    }

  }
);


</script>

</body>
</html>
